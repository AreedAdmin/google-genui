# =============================================================================
# Trellis — .env.example  (MVP scope)
# =============================================================================
# Copy to `.env` and fill in real values:   cp .env.example .env
# NEVER commit `.env`. Only this placeholder file is tracked.
#
# This file is trimmed to ONLY what the MVP needs to work as intended:
#   1) generate a real, grounded gen-UI plan   (planner + dependency engine + analysis + widgets)
#   2) execute approved nodes via the Claude Code agent
#   3) prune a subtree + share/delegate it to another user
# Everything for v2 (analytics, observability, rate limits, sandbox hardening) was
# removed — see the "DEFERRED TO V2" list at the bottom for what & why.
#
# Legend:  [PUBLIC] safe in the browser (NEXT_PUBLIC_*, never a secret)
#          [SECRET] server/worker only — never in the client bundle
#          used by: web | api | workers | analysis
# =============================================================================


# -----------------------------------------------------------------------------
# 1) RUNTIME
# -----------------------------------------------------------------------------
# Node mode: development | production. used by: web,api,workers
NODE_ENV=development
# Log verbosity: debug | info | warn | error. used by: api,workers,analysis
LOG_LEVEL=debug


# -----------------------------------------------------------------------------
# 2) SERVICE URLS & PORTS
# -----------------------------------------------------------------------------
# Public URL of the web app — used to build the canvas deep link the /trellis
# launcher returns. [PUBLIC] used by: web,api,workers
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public URL of the orchestration REST API (Fastify /v1). [PUBLIC] used by: web
NEXT_PUBLIC_API_URL=http://localhost:8080

# Port the orchestration API listens on. [SECRET] used by: api
API_PORT=8080

# Internal URL of the Python dependency-analysis service (the engine that grounds
# the plan in real symbols). Server-to-server only. [SECRET] used by: api,workers
ANALYSIS_SERVICE_URL=http://localhost:8000


# -----------------------------------------------------------------------------
# 3) SUPABASE  (Postgres · Auth · Realtime · Storage)
#    Durable plan/node/edge/branch data, user auth (email+password / GitHub),
#    Realtime feeds for the live canvas, Storage for diffs + delegation specs.
# -----------------------------------------------------------------------------
# Project URL (local dev default shown). [PUBLIC] used by: web,api,workers
NEXT_PUBLIC_SUPABASE_URL=https://rhlcycxijjxodxelutxt.supabase.co
# Publishable/anon key — browser-safe; access still gated by RLS. [PUBLIC] used by: web
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJobGN5Y3hpamp4b2R4ZWx1dHh0Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODEzMDg2MDMsImV4cCI6MjA5Njg4NDYwM30.PUPUfK3XvXyed7WyLfXfOO2PqgG4SMOHVTJPKTmqG9U
# Service-role key — bypasses RLS; workers/api scope every query by plan/project.
# Never in the web bundle. [SECRET] used by: api,workers
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret so the API can verify user tokens + drive RLS (needed for sharing).
# [SECRET] used by: api
SUPABASE_JWT_SECRET=
# Direct Postgres connection (runtime queries + migrations). Local port is 54322.
# [SECRET] used by: api,workers
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.rhlcycxijjxodxelutxt.supabase.co:5432/postgres
#
# NOTE: GitHub *login* is configured in the Supabase Auth dashboard (provider
# client id/secret live there, not here). Repo *cloning* uses GITHUB_TOKEN (§7).


# -----------------------------------------------------------------------------
# 4) REDIS  (job queues · locks · live run streams)
#    Powers execution: BullMQ queues, the parallel-dispatch locks, and the
#    stream:run:* log/diff feed that animates nodes live on the canvas.
# -----------------------------------------------------------------------------
# [SECRET] used by: api,workers,analysis
REDIS_URL=redis://localhost:6379


# -----------------------------------------------------------------------------
# 5) ANTHROPIC / CLAUDE  (Trellis's own planning agents)
#    Used by the planner, dependency reasoning, analysis, and widget-spec agents
#    — i.e. everything that produces the gen-UI plan. NOT the build runner (§6).
# -----------------------------------------------------------------------------
# [SECRET] used by: api,workers
ANTHROPIC_API_KEY=sk-ant-replace-me
# Model per purpose (Opus for deep reasoning, Sonnet for widget specs).
# Dependency reasoning reuses PLANNER_MODEL. [SECRET] used by: workers
PLANNER_MODEL=claude-opus-4-8
ANALYSIS_MODEL=claude-opus-4-8
WIDGET_MODEL=claude-sonnet-4-6


# -----------------------------------------------------------------------------
# 6) EXECUTION — Claude Code runner (writes the code for approved nodes)
#    plan/02-agent-system/agent-runners.md
# -----------------------------------------------------------------------------
# MVP runner. Keep `claude_code`; `native` is the built-in fallback. used by: workers
EXECUTION_BACKEND=claude_code
# Path to the Claude Code binary the runner spawns headlessly
# (claude -p ... --output-format stream-json --cwd <worktree>). [SECRET] used by: workers
CLAUDE_CODE_PATH=/usr/local/bin/claude
# The spawned Claude Code reuses ANTHROPIC_API_KEY (§5) for auth in the MVP.
# Model + guardrails for the runner. permission mode is non-interactive because
# Trellis (not the user) adjudicates the final diff. [SECRET] used by: workers
CLAUDE_CODE_MODEL=claude-sonnet-4-6
CLAUDE_CODE_PERMISSION_MODE=acceptEdits
CLAUDE_CODE_MAX_TURNS=40
# Host dir where ephemeral per-branch git worktrees are created (isolation for
# parallel builds). [SECRET] used by: workers
WORKTREE_ROOT=/var/trellis/worktrees
# How many independent branches may build at once (the parallel-dispatch cap).
# [SECRET] used by: workers
MAX_CONCURRENT_BRANCHES=4


# -----------------------------------------------------------------------------
# 7) GITHUB — repo access (clone + index the target repo)
# -----------------------------------------------------------------------------
# Personal Access Token used to clone/index the repo being planned. For the demo
# this is the simplest path; private repos via GitHub login arrive with that flow.
# [SECRET] used by: workers
GITHUB_TOKEN=replace-with-github-pat


# -----------------------------------------------------------------------------
# 8) ANALYSIS SERVICE  (Python / FastAPI · tree-sitter · networkx)
# -----------------------------------------------------------------------------
# Port the analysis service listens on. [SECRET] used by: analysis
ANALYSIS_SERVICE_PORT=8000
# Languages parsed in the MVP (comma-separated). [SECRET] used by: analysis
TREE_SITTER_LANGUAGES=typescript,javascript


# -----------------------------------------------------------------------------
# 9) /trellis LAUNCHER  (MCP server entry point)
#    plan/01-architecture/integration-surfaces.md
# -----------------------------------------------------------------------------
# Secret that signs the device-link token binding a coding agent's /trellis calls
# to a Trellis user session (RLS-scoped like the web app). [SECRET] used by: api
TRELLIS_MCP_TOKEN_SECRET=replace-with-random-32+char-string
# Port the MCP server listens on. [SECRET] used by: api
MCP_SERVER_PORT=8090


# -----------------------------------------------------------------------------
# 10) API
# -----------------------------------------------------------------------------
# Origins allowed to call the API (CORS) — the web app origin. [SECRET] used by: api
CORS_ALLOWED_ORIGINS=http://localhost:3000


# =============================================================================
# DEFERRED TO V2 (intentionally removed — re-add when these matter)
# -----------------------------------------------------------------------------
# Analytics / observability (data collection, not function):
#   NEXT_PUBLIC_POSTHOG_KEY, POSTHOG_API_KEY, POSTHOG_HOST
#   OTEL_EXPORTER_OTLP_ENDPOINT, OTEL_EXPORTER_OTLP_HEADERS, OTEL_SERVICE_NAME
# Rate limiting / cost guards (protection at scale):
#   RATE_LIMIT_USER_PER_MIN, RATE_LIMIT_ORG_PER_MIN, ORG_DAILY_TOKEN_BUDGET
# Sandbox hardening (customer-facing isolation; MVP runs Claude Code in an
# isolated git worktree on a trusted host):
#   SANDBOX_RUNTIME, PACKAGE_PROXY_URL, SANDBOX_EGRESS_PROXY_URL,
#   SANDBOX_CPU, SANDBOX_MEM_MB, SANDBOX_MAX_PIDS, SANDBOX_WALLCLOCK_S
#   ANTHROPIC_BASE_URL (egress proxy), INTERNAL_SERVICE_TOKEN, ENCRYPTION_KEY
# Multi-env / feature gating:
#   APP_ENV
# Folded into code defaults for the MVP (re-expose if you need to tune):
#   DATABASE_DIRECT_URL, REDIS_NAMESPACE, STORAGE_BUCKET_* (fixed names),
#   ANTHROPIC_MAX_RETRIES, ANTHROPIC_PROMPT_CACHE, DEPENDENCY_MODEL,
#   REPLAN_MODEL, NATIVE_BUILDER_MODEL, WORKER_CONCURRENCY, LOCK_TTL_MS,
#   LOCK_FILE_HEARTBEAT_MS, RUN_MAX_REPAIR, RUN_MAX_TOKENS, ANALYSIS_CACHE_TTL_S
# Moved to the Supabase dashboard (not app env):
#   GITHUB_OAUTH_CLIENT_ID, GITHUB_OAUTH_CLIENT_SECRET
# =============================================================================
